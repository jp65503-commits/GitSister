    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1423530834401933403, guid: 5b8886dc5d608c649a13e256d67d2455, type: 3}
      propertyPath: textoNovo
      value: "08 \u2014 O CAMINHO \\n <size=70%>Di\xE1rio de um viajante </size> \\n\\n Vi dois jovens seguindo em dire\xE7\xE3o \xE0 floresta hoje. O rapaz parecia conhecer bem o caminho. A garota caminhava logo atr\xE1s, sem questionar para onde estavam indo. Tive uma estranha sensa\xE7\xE3o de j\xE1 ter visto aquela cena antes. "
      objectReference: {fileID: 0}
    - target: {fileID: 6581562235779728397, guid: 5b8886dc5d608c649a13e256d67d2455, type: 3}
      propertyPath: m_Name
